{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Copy Config",
            "type": "shell",
            "command": "cp ${env:HOME}/os161/src/kern/conf/DUMBVM ${env:HOME}/os161/src/kern/conf/${input:VersionName}",
            "problemMatcher": []
        },
        {
            "label": "Run Config",
            "type": "shell",
            "command": "cd ${env:HOME}/os161/src/kern/conf/;./config ${input:VersionName}",
            "problemMatcher": []
        },
        {
            "label": "Make Depend",
            "type": "shell",
            "command": "cd ${env:HOME}/os161/src/kern/compile/${input:VersionName};bmake depend",
            "problemMatcher": []
        },
        {
            "label": "Build and Install",
            "type": "shell",
            "command": "cd ${env:HOME}/os161/src/kern/compile/${input:VersionName};bmake;bmake install",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run OS161",
            "type": "shell",
            "command": "cd ${env:HOME}/os161/root;sys161 -w kernel",
            "problemMatcher": []
        },
        {
            "label": "Run OS161 (no debug)",
            "type": "shell",
            "command": "cd ${env:HOME}/os161/root;sys161 kernel",
            "problemMatcher": []
        },
        {
            "label": "Build Syscall Tests",
            "type": "shell",
            "command": "cd ${env:HOME}/os161/src && bmake build && bmake install",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Run Syscall Tests",
            "type": "shell",
            "command": "cd ${env:HOME}/os161/root && printf '%s\n' 'p /testbin/chdirtest' 'p /testbin/closetest' 'p /testbin/dup2test' 'p /testbin/execvtest' 'p /testbin/getcwdtest' 'p /testbin/getpidtest' 'p /testbin/lseektest' 'p /testbin/opentest' 'p /testbin/readtest' 'p /testbin/waitpidtest' 'p /testbin/writetest' 'q' | sys161 kernel",
            "problemMatcher": []
        },
        {
            "label": "Build and Run Syscall Tests",
            "type": "shell",
            "command": "true",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Syscall Tests",
                "Run Syscall Tests"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ],
    "inputs": [
        {
            "type": "promptString",
            "id": "VersionName",
            "description": "Kernel version name"
        }
    ]
}